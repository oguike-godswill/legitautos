# ---------------------------------------------------------------------------
# Required in every environment
# ---------------------------------------------------------------------------

# MongoDB connection string used by app/lib/dbConnect.ts
MONGODB_URI=

# Public base URL of the site. Used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Image uploads (Cloudinary) - required for the admin image uploader
# ---------------------------------------------------------------------------

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Admin authentication
# ---------------------------------------------------------------------------
# /admin and every mutating API route require a signed session cookie.
# Without these values the login page renders a "not configured" notice and
# all admin endpoints keep returning 401.

# The single admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: show a nicer name in the admin UI.
ADMIN_NAME=Admin

# Optional alternative to ADMIN_PASSWORD: a bcrypt hash of the admin password.
# Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# When set, ADMIN_PASSWORD_HASH takes precedence over ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=

# HMAC key used to sign the session cookie. Use at least 16 characters and a
# long random value, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Optional: override the public dealership details shown across the site.
# Defaults live in app/config/dealership.ts.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_DEALERSHIP_NAME=
# NEXT_PUBLIC_DEALERSHIP_PHONE=
# NEXT_PUBLIC_DEALERSHIP_WHATSAPP=
# NEXT_PUBLIC_DEALERSHIP_EMAIL=
# NEXT_PUBLIC_DEALERSHIP_ADDRESS=
# NEXT_PUBLIC_DEALERSHIP_CITY=
# NEXT_PUBLIC_DEALERSHIP_STATE=
# NEXT_PUBLIC_DEALERSHIP_COUNTRY=
# NEXT_PUBLIC_DEALERSHIP_HOURS=
# NEXT_PUBLIC_SITE_URL=
